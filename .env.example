# Copy to .env and fill in. Never commit .env.

# Cursor Cloud Agents API (https://cursor.com/settings)
CURSOR_API_KEY=

# Public base URL of this backend (used in agent webhook callback), e.g. https://workbalancer.example.com
PUBLIC_BASE_URL=https://localhost

# Webhook secret for Cursor (min 32 chars) — must match what you pass in launch payload
CURSOR_WEBHOOK_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric user IDs allowed to use the bot (MVP allowlist)
TELEGRAM_ALLOWED_USER_IDS=

# PostgreSQL
POSTGRES_USER=workbalancer
POSTGRES_PASSWORD=workbalancer
POSTGRES_DB=workbalancer
DATABASE_URL=postgresql+asyncpg://workbalancer:workbalancer@postgres:5432/workbalancer

# Redis
REDIS_URL=redis://redis:6379/0

# Limits
MAX_PARALLEL_AGENTS_PER_USER=2

# Task launch: require inline confirmation (true/false)
REQUIRE_TASK_CONFIRMATION=true
